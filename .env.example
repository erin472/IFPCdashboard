# Site access
PASSWORD=replace-with-access-password

# Guidewheel API (telemetry for the temp/humidity tab)
GUIDEWHEEL_API_URL=https://api.safisense.com/api
GUIDEWHEEL_API_KEY=replace-with-telemetry-scoped-api-key
COMPANY_ID=replace-with-ifpc-company-id

# Sensor identifiers — fill in after the IFPC install (see Bedford Park repo for how these were confirmed)
GW_TEMP_DEVICE_ID=replace_ifpc_temp_device_id
GW_HUMIDITY_DEVICE_ID=replace_ifpc_hum_device_id
GW_TEMP_METRIC=TempF
GW_HUMIDITY_METRIC=Hum

# Tuning (optional)
GW_HISTORY_DAYS=30
GW_SYNC_INTERVAL_MINUTES=60
PLANT_TZ=America/Chicago
SENSOR_REFRESH_TOKEN=optional-token-for-cron-refresh
